DISCORD_BOT_TOKEN=
SERPAPI_KEY=

# Optional but strongly recommended. Free key from https://saucenao.com/user.php
# (Account -> api). When Google Lens finds nothing, the bot retries via SauceNAO,
# which indexes Pixiv/Danbooru/Twitter/DeviantArt and catches most of the
# illustration and anime sources Lens misses. Free tier: 100 searches/day.
# Without this the bot simply reports no match, exactly as it does today.
SAUCENAO_API_KEY=

# Everything below is optional - leave these commented out for the defaults.

# Discard SauceNAO matches below this similarity percentage (default 60).
# Lower catches more edits and crops; higher cuts false positives.
#SAUCENAO_MIN_SIMILARITY=60

# One of DEBUG, INFO, WARNING, ERROR, CRITICAL. Defaults to INFO.
# DEBUG also turns on discord.py's own gateway logging, which is very noisy.
#LOG_LEVEL=INFO

# Log file path, relative to bot.py unless absolute. Defaults to wherefrom.log.
# Use LOG_FILE=none to turn file logging off entirely - worth doing on
# Railway/Render, where the disk is wiped on restart and stdout is captured.
#LOG_FILE=wherefrom.log

# Rotate the log once it reaches this many bytes (default 1000000, ~1 MB),
# keeping this many old copies (default 3). LOG_BACKUP_COUNT=0 empties the file
# on rotation instead of keeping copies.
#LOG_MAX_BYTES=1000000
#LOG_BACKUP_COUNT=3
