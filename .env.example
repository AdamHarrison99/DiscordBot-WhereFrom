DISCORD_BOT_TOKEN=
SERPAPI_KEY=

# Optional. Free key from https://saucenao.com/user.php (Account -> api), 100/day.
# Retried when Google Lens finds nothing; catches most illustration and anime
# sources Lens misses. Without it the bot just reports no match.
SAUCENAO_API_KEY=

# Optional. Key from https://openrouter.ai/keys. Enables @-mention replies, including
# questions about an attached image. Blank means mentions are ignored.
#
# THIS COSTS MONEY: $0.0001-0.0008 a reply through openrouter/auto. Set
# OPENROUTER_MODEL=openrouter/free for zero cost, at the price of image support.
OPENROUTER_API_KEY=

# Everything below is set to its default. Delete or blank any line to keep the default.

# The chat agent's system prompt. Relative to bot.py unless absolute. Gitignored -
# copy agent_context.example.md to it and edit.
AGENT_CONTEXT_FILE=agent_context.md

# openrouter/auto picks per prompt and is paid. openrouter/free is text-only.
# Any model id works, e.g. anthropic/claude-haiku-4.5.
#
# Every model setting takes a comma-separated list, tried in order when one is
# down or rate-limited. openrouter/free is appended automatically, so the last
# attempt always costs nothing. An id that doesn't exist is a hard error, not a
# skipped entry - check spelling. A leading ~ is OpenRouter's "latest" alias and
# must be kept (~vendor/model-latest).
OPENROUTER_MODEL=openrouter/auto

# Per-kind overrides; blank falls back to OPENROUTER_MODEL. Pin them to stop auto
# picking differently each time. The image model needs vision, and tool calling for
# the built-in reverse image search.
# The image model needs BOTH vision and tool calling - google/gemini-2.5-flash-image
# has no tools and would silently break the reverse image search from a mention.
# openrouter/free is NOT appended to this one: it has no vision endpoint, so it
# would only turn "everything was busy" into "your backend is misconfigured".
# OpenRouter takes at most 3 models per request. Anything past the third is
# dropped with a warning at startup - and the appended free router counts.
# Pictures and clips are set apart because audio is the fussier of the two: a model
# can see perfectly well and still answer that it cannot listen. MEDIA sets both at
# once and either kind overrides it. A message carrying both goes to the audio model.
#   e.g. OPENROUTER_TEXT_MODEL=deepseek/deepseek-v4-flash-0731
#        OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-lite,google/gemini-2.5-flash
#        OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash
OPENROUTER_TEXT_MODEL=
OPENROUTER_MEDIA_MODEL=
OPENROUTER_IMAGE_MODEL=
OPENROUTER_AUDIO_MODEL=

# Price ceiling in dollars per million tokens. Blank means none; 0 means free only.
# Too low returns a 404 rather than something cheaper. The completion price binds:
# vision routes to $1.62-$5.00/M, so 1 kills images while text still works.
OPENROUTER_MAX_PRICE=5

# Reply length cap in tokens. Three sentences is ~70; the rest is headroom for emoji
# and non-Latin scripts. The "three sentences" instruction lives in the context file.
OPENROUTER_MAX_TOKENS=150

# Mentions per user per minute. Over it the bot reacts with an hourglass, free.
MENTION_RATE_LIMIT_PER_MINUTE=4

# Token ceiling on history plus question. Oldest history goes first, then the
# question is trimmed. The context file is never counted or trimmed, so a big one is
# paid for on every reply. Counted at ~4 characters per token. Images aren't counted.
MAX_CONTEXT_TOKENS=2000

# Per-channel conversation memory, in memory only - a restart forgets. TURNS is
# question-and-answer pairs; MINUTES is how long a quiet channel keeps them. Replying
# to the bot continues without an @. TURNS=0 makes every message standalone.
# History is sent every request, so it counts against MAX_CONTEXT_TOKENS.
CONVERSATION_MEMORY_TURNS=10
CONVERSATION_MEMORY_MINUTES=30

# Lets the agent search Google when it decides it needs to. Comes out of the SAME
# SerpApi 100-a-month tier as the image search, so it trades against the bot's main
# job. DAILY_LIMIT is a per-day cap held in memory; 0 turns the feature off. One
# message triggers at most one search. RESULTS costs tokens, not quota.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_DAILY_LIMIT=10
WEB_SEARCH_RESULTS=5

# Lets the agent open a posted link and read it. A plain HTTP GET, so no SerpApi
# quota - it costs prompt tokens, which MAX_CHARS and PER_MESSAGE bound.
# Public http(s) only, redirects included, so it can't be aimed at your own network.
# No paywalled or login-only sites; X, Instagram and TikTok refuse, YouTube gives up
# little past the title. Tool output is capped at 4000 chars, so MAX_CHARS above
# 3000 buys nothing.
PAGE_READ_ENABLED=true
PAGE_READ_MAX_CHARS=3000
PAGE_READ_PER_MESSAGE=2

# Tool-call rounds per reply. 2 lets it chain (read a link, then search the picture
# on it) for another OpenRouter call. Minimum 1. Tools are off on the last round.
AGENT_TOOL_ROUNDS=2

# Ambient replies: the bot joins a conversation without being @-mentioned when it
# judges it has something to add.
#
# THIS WIDENS WHAT LEAVES YOUR MACHINE. Unaddressed messages in the listed channels
# are sent to OpenRouter. Off by default, and CHANNELS is empty, so enabling alone
# does nothing. DMs are refused even if you list one.
#
# Each burst is scored 0-100 by a cheap text-only model. MODE=observe scores and logs
# without posting - run it for a few days, then set THRESHOLD and switch to reply.
# Nothing anyone says is written to the log or to disk; the buffer is memory only.
AMBIENT_ENABLED=false
AMBIENT_CHANNELS=
AMBIENT_MODE=observe
# Blank uses openrouter/free: no cost, but a small shared pool that is often busy,
# and narrower still if your OpenRouter privacy settings restrict providers. A list
# of cheap models is the reliable setup; free is appended as the last attempt.
AMBIENT_GATE_MODEL=
AMBIENT_THRESHOLD=70
# Seconds of quiet before a burst is judged, and the ceiling that fires anyway so a
# busy channel isn't starved.
AMBIENT_DEBOUNCE_SECONDS=5
AMBIENT_MAX_WAIT_SECONDS=30
# How long a channel stays quiet after the bot speaks in it. No score overrides it,
# and a channel in cooldown costs nothing - the check runs before the gate is called.
# This is the only ceiling on how often the bot speaks, so 0 means no ceiling at all.
AMBIENT_COOLDOWN_SECONDS=120
# Messages handed to the judge, and how many new ones during generation abort the post.
AMBIENT_BUFFER_MESSAGES=12
AMBIENT_STALE_MESSAGES=3
# Ignore a message entirely if it carries anything the bot can't process - a
# link, a video, a document. Off by default, where only the unopenable part is
# skipped and a caption alongside it is still judged. Images are fine either way.
AMBIENT_STRICT_CONTENT=false

# Send voice notes and audio clips to OPENROUTER_AUDIO_MODEL, on both the mention
# and ambient paths. Audio has no URL form, so the clip is downloaded and inlined
# as base64 - hence the size cap. Refusals are intermittent and model-dependent,
# so probe an id before trusting it: agentic/tools/probe_media.py
AUDIO_ENABLED=true
AUDIO_MAX_BYTES=4000000

# The whole prompt the gate scores with: what the bot is, and what deserves a reply.
# It never sees the persona in agent_context.md, so this file is the only description
# of the bot it has. judge_template.md is yours and is gitignored;
# judge_template.example.md is committed and is what a clone without one falls back to.
# Needs a # System and a # Template section, and {transcript} where the messages go.
# Read at startup only, so an edit needs a restart.
JUDGE_TEMPLATE_FILE=judge_template.example.md

# What the ambient reply itself is told, on top of agent_context.md: that nobody asked,
# how to read the transcript, and what shape an unprompted message takes. Same deal as
# above - reply_template.md is yours and gitignored, reply_template.example.md is the
# committed fallback. Needs a # Context and an # Instruction section.
REPLY_TEMPLATE_FILE=reply_template.example.md

# Discard SauceNAO matches below this similarity percentage.
# Lower catches more edits and crops; higher cuts false positives.
SAUCENAO_MIN_SIMILARITY=60

# One of DEBUG, INFO, WARNING, ERROR, CRITICAL. INFO logs every tool call by name and
# what came back. DEBUG adds search result titles and links, plus discord.py's own very
# noisy gateway logging. Neither level writes what anyone said, or anything the model
# wrote out of it.
LOG_LEVEL=INFO

# Log file path, relative to bot.py unless absolute. LOG_FILE=none disables file
# logging - worth doing on Railway/Render, where the disk is wiped and stdout is kept.
LOG_FILE=wherefrom.log

# Rotate at this many bytes, keeping this many copies. 0 empties instead of keeping.
LOG_MAX_BYTES=1000000
LOG_BACKUP_COUNT=3
