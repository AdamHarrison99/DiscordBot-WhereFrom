DISCORD_BOT_TOKEN=
SERPAPI_KEY=

# Optional but strongly recommended. Free key from https://saucenao.com/user.php
# (Account -> api). When Google Lens finds nothing, the bot retries via SauceNAO,
# which indexes Pixiv/Danbooru/Twitter/DeviantArt and catches most of the
# illustration and anime sources Lens misses. Free tier: 100 searches/day.
# Without this the bot simply reports no match, exactly as it does today.
SAUCENAO_API_KEY=

# Optional. Key from https://openrouter.ai/keys. Set it and the bot answers questions
# when someone @-mentions it, and can look at any image attached to that message.
# Leave it blank and mentions are ignored - no other behaviour changes.
#
# THIS COSTS MONEY. Requests go through openrouter/auto, which routes to whichever
# model suits the prompt, paid ones included. Typical cost is $0.0001-0.0008 per
# reply. Set OPENROUTER_MODEL=openrouter/free below for zero cost, at the price of
# losing image support.
OPENROUTER_API_KEY=

# Everything below is set to its default value. Change or delete any line freely -
# a deleted or blank line falls back to the same default.

# The chat agent's system prompt: who the bot is and how it should answer @-mentions.
# Path is relative to bot.py unless absolute. agent_context.md is gitignored - copy
# agent_context.example.md to it and edit to taste.
AGENT_CONTEXT_FILE=agent_context.md

# Model for @-mention replies. openrouter/auto is paid and picks per prompt.
# openrouter/free costs nothing 
# Any specific model id works too, e.g. anthropic/claude-haiku-4.5.
OPENROUTER_MODEL=openrouter/auto

# Optional per-kind overrides. Leave blank and both fall back to OPENROUTER_MODEL
# above, i.e. auto routing. Set them to stop auto picking a different model every
# time - handy because the image model must support vision, and the model that
# answers image questions must also support tool calling for the built-in reverse
# image search to work.
#   e.g. OPENROUTER_TEXT_MODEL=deepseek/deepseek-v4-flash-0731
#        OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash
OPENROUTER_TEXT_MODEL=
OPENROUTER_IMAGE_MODEL=

# Ceiling on routed price, in dollars per million tokens, applied to prompt and
# completion. Blank means no ceiling; 0 is a real value meaning free models only.
#
# Too low and OpenRouter returns a 404 instead of falling back to something cheaper.
# The completion price is what binds: vision replies route to models charging $1.62
# (glm-5.2), $2.50 (gemini-2.5-flash) or $5.00 (claude-haiku-4.5) per million, so a
# ceiling of 1 kills image support while text keeps working. 5 covers all of them.
OPENROUTER_MAX_PRICE=5

# Cap on reply length in tokens. Three sentences is around 70 tokens; the rest is
# headroom for emoji and non-Latin scripts, which cost several tokens each. Reasoning
# is disabled on every request, so all of this goes to the visible answer. The "keep
# it to three sentences" instruction itself lives in the agent context file - this is
# only the backstop. If a reply is cut off mid-sentence, the bot drops the unfinished
# fragment rather than posting it.
OPENROUTER_MAX_TOKENS=150

# How many mentions one user may send per minute. Over this the bot reacts with an
# hourglass instead of replying, and spends nothing.
MENTION_RATE_LIMIT_PER_MINUTE=4

# Ceiling on the conversation history and the user's question, in tokens. Over it, the
# oldest history is dropped first and then the question is trimmed.
#
# The agent context file is NOT counted and is never trimmed - it's the bot's identity
# and rules, and half a rulebook is worse than a shorter memory. That means a large
# context file is paid for on every single reply, so keep it tight. Startup logs its
# size and warns if it dwarfs this budget.
#
# Counted at roughly four characters per token, since auto-routing spans models with
# different tokenizers. Attached images aren't counted; only the model knows their cost.
MAX_CONTEXT_TOKENS=2000

# Conversation memory, kept per channel and in memory only - a restart forgets it.
# TURNS is how many question-and-answer pairs are carried forward; MINUTES is how
# long a quiet channel keeps them before the next message starts fresh. Replying to
# one of the bot's messages continues the conversation without needing an @.
# Set TURNS=0 to make every message standalone again.
#
# History is sent with every request, so it counts against MAX_CONTEXT_TOKENS above
# and raises the per-reply cost. The oldest turns are dropped first when it doesn't fit.
CONVERSATION_MEMORY_TURNS=10
CONVERSATION_MEMORY_MINUTES=30

# Lets the chat agent search Google when someone asks it something it doesn't know.
# It decides for itself when to search, and each search comes out of the SAME SerpApi
# 100-a-month free tier the reverse image search uses - so this is a straight trade
# against the bot's main job.
#
# DAILY_LIMIT is the guard: a process-wide cap on agent searches per calendar day,
# counted in memory, so a restart hands the day's allowance back. 0 turns the feature
# off just as WEB_SEARCH_ENABLED=0 does. On top of it, one message can only trigger
# one search however many times the model asks.
#
# RESULTS is how many Google results are handed to the model. More costs no extra
# quota - one search is one search - but it does raise the per-reply token cost, and
# the results are truncated at 2000 characters before they reach the model.
WEB_SEARCH_ENABLED=1
WEB_SEARCH_DAILY_LIMIT=10
WEB_SEARCH_RESULTS=5

# Lets the chat agent open a link someone posts and read what's on it - articles,
# wikis, docs, Reddit threads (fetched as JSON, no key needed). This is a plain HTTP
# GET, so it spends no SerpApi quota; what it costs is prompt tokens on the follow-up
# reply, which is what MAX_CHARS and PER_MESSAGE bound.
#
# It refuses anything that isn't a public http(s) address - including redirects into
# one - so the bot can't be pointed at your own network. It can't read paywalled or
# login-only sites, or anything that isn't text: X/Twitter, Instagram and TikTok all
# refuse, and YouTube gives up little more than the title. An image link is handed to
# the reverse image search instead, and a page's own preview image can be searched the
# same way. PAGE_READ_MAX_CHARS is capped in practice by the 4000-character ceiling on
# tool output, so raising it much past 3000 buys nothing.
PAGE_READ_ENABLED=1
PAGE_READ_MAX_CHARS=3000
PAGE_READ_PER_MESSAGE=2

# How many rounds of tool calls the agent gets per reply. Two lets it chain - read a
# link, then reverse search the picture on it - at the cost of another OpenRouter call.
# 1 allows a single search then an answer. Minimum 1; anything lower falls back to 2.
# On the last round tools are switched off for that request, so the model has to
# answer rather than ask for something it can't be given.
AGENT_TOOL_ROUNDS=2

# Discard SauceNAO matches below this similarity percentage.
# Lower catches more edits and crops; higher cuts false positives.
SAUCENAO_MIN_SIMILARITY=60

# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
# DEBUG also turns on discord.py's own gateway logging, which is very noisy.
LOG_LEVEL=INFO

# Log file path, relative to bot.py unless absolute.
# Use LOG_FILE=none to turn file logging off entirely - worth doing on
# Railway/Render, where the disk is wiped on restart and stdout is captured.
LOG_FILE=wherefrom.log

# Rotate the log once it reaches this many bytes (~1 MB), keeping this many old
# copies. LOG_BACKUP_COUNT=0 empties the file on rotation instead of keeping copies.
LOG_MAX_BYTES=1000000
LOG_BACKUP_COUNT=3
